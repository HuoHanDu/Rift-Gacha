{
  "name": "rift-gacha",
  "version": "0.1.0",
  "private": true,
  "description": "峡谷全随机构筑器 —— 英雄联盟召唤师峡谷娱乐向随机构筑生成器",
  "scripts": {
    "dev:h5": "uni",
    "build:h5": "uni build",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin",
    "preview:h5": "vite preview --outDir dist/build/h5",
    "serve:dist": "node scripts/serve-dist.mjs",
    "fetch:data": "node scripts/fetch-data.mjs",
    "fetch:101": "node scripts/fetch-101.mjs",
    "fetch:101:build": "node scripts/fetch-101-build.mjs",
    "sample": "vite-node --config vitest.config.ts scripts/dump-sample.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020620260917001",
    "@dcloudio/uni-components": "3.0.0-5020620260917001",
    "@dcloudio/uni-h5": "3.0.0-5020620260917001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020620260917001",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "3.0.0-5020620260917001",
    "@dcloudio/uni-stacktracey": "3.0.0-5020620260917001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/runtime-core": "3.5.43",
    "@vue/server-renderer": "3.5.43",
    "rollup": "4.14.3",
    "typescript": "^5.4.5",
    "vite": "5.2.8",
    "vitest": "^1.6.0",
    "vue-tsc": "^2.0.16"
  }
}
